// Branch: feature/database

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BlockerType {
  STUCK
  TECHNICAL_ASSISTANCE
  WAITING_FOR_PERSON
  UNCLEAR_REQUIREMENTS
  NEEDS_RESOURCES
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerPrivacy {
  PRIVATE_ADMINS
  TEAM
  REPORTER_AND_ADMINS
}

enum BlockerStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  password      String
  avatar        String?
  systemRole    SystemRole       @default(MEMBER)
  isActive      Boolean          @default(true)
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  memberships   WorkspaceMember[]
  tasks         Task[]           @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreator")
  comments      Comment[]
  activityLogs  ActivityLog[]
  joinRequests  JoinRequest[]
  feedbacks     ProjectFeedback[]
  memoryEntries TaskMemoryEntry[]
  reportedBlockers     TaskBlocker[] @relation("BlockerReporter")
  acknowledgedBlockers TaskBlocker[] @relation("BlockerAcknowledger")
  resolvedBlockers     TaskBlocker[] @relation("BlockerResolver")
  handoffsSent         TaskHandoff[] @relation("HandoffFrom")
  handoffsReceived     TaskHandoff[] @relation("HandoffTo")
  handoffAcks          TaskHandoffAcknowledgment[]

  @@index([email])
}

model Workspace {
  id          String           @id @default(cuid())
  name        String
  description String?
  slug        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members     WorkspaceMember[]
  boards      Board[]
  activityLogs ActivityLog[]
  joinRequests JoinRequest[]
  feedbacks   ProjectFeedback[]
  memoryEntries TaskMemoryEntry[]
  blockers    TaskBlocker[]
  handoffs    TaskHandoff[]
  healthSnapshots ProjectHealthSnapshot[]

  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())

  userId      String
  workspaceId String

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model Board {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]

  @@index([workspaceId])
}

model Column {
  id       String  @id @default(cuid())
  name     String
  position Int     @default(0)

  boardId  String
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  priority      Priority  @default(MEDIUM)
  position      Int       @default(0)
  dueDate       DateTime?
  expectedHours Int?
  labels        String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  creatorId   String
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id])

  comments      Comment[]
  activityLogs  ActivityLog[]
  memoryEntries TaskMemoryEntry[]
  blockers      TaskBlocker[]
  handoffs      TaskHandoff[]

  @@index([columnId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  action      String
  details     Json?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
}

model JoinRequest {
  id          String            @id @default(cuid())
  status      JoinRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model ProjectFeedback {
  id          String    @id @default(cuid())
  rating      Int
  category    String    @default("GENERAL")
  message     String
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model TaskMemoryEntry {
  id                    String   @id @default(cuid())
  originalProblem       String?
  expectedOutcome       String?
  workCompleted         String?
  approachesAttempted   String?
  technicalDecisions    String?
  outstandingQuestions  String?
  nextRecommendedAction String?
  supportingLinks       String[]
  createdAt             DateTime @default(now())

  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@index([workspaceId])
}

model TaskBlocker {
  id               String          @id @default(cuid())
  type             BlockerType
  severity         BlockerSeverity @default(MEDIUM)
  privacy          BlockerPrivacy  @default(PRIVATE_ADMINS)
  status           BlockerStatus   @default(OPEN)
  explanation      String?
  resolutionNote   String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  taskId           String
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reporterId       String
  reporter         User      @relation("BlockerReporter", fields: [reporterId], references: [id])

  acknowledgedById String?
  acknowledgedBy   User?     @relation("BlockerAcknowledger", fields: [acknowledgedById], references: [id])

  resolvedById     String?
  resolvedBy       User?     @relation("BlockerResolver", fields: [resolvedById], references: [id])

  @@index([taskId])
  @@index([workspaceId, status])
  @@index([reporterId])
}

model TaskHandoff {
  id                   String   @id @default(cuid())
  completedSummary     String
  remainingWork        String
  problemsEncountered  String?
  technicalDecisions   String?
  firstStepRecommended String
  importantLinks       String[]
  createdAt            DateTime @default(now())

  taskId         String
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  fromUserId     String
  fromUser       User      @relation("HandoffFrom", fields: [fromUserId], references: [id])

  toUserId       String
  toUser         User      @relation("HandoffTo", fields: [toUserId], references: [id])

  acknowledgment TaskHandoffAcknowledgment?

  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@index([toUserId])
}

model TaskHandoffAcknowledgment {
  id             String      @id @default(cuid())
  note           String?
  acknowledgedAt DateTime    @default(now())

  handoffId      String      @unique
  handoff        TaskHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  userId         String
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProjectHealthSnapshot {
  id                 String    @id @default(cuid())
  score              Int
  overdueCount       Int
  unresolvedBlockers Int
  staleTasksCount    Int
  reviewWaitingCount Int
  exceededTimeCount  Int
  completedTasks     Int
  pendingTasks       Int
  warnings           Json
  createdAt          DateTime  @default(now())

  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
